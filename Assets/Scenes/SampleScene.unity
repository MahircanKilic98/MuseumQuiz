      m_Calls: []
  m_text: "Seerosen-Serie (ab 1899)\n\nIn seinem Garten in Giverny fand Monet sein
    zentrales Motiv: den Seerosenteich. Er malte ihn\ndutzende Male und konzentrierte
    sich dabei ganz auf Lichtreflexe, Wasseroberfl\xE4che und Farben.\nDer Horizont
    fehlt \u2013 das Bild wirkt wie ein Ausschnitt aus der Natur, ganz ohne festen
    Raum."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
  m_sharedMaterial: {fileID: 2164040, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
