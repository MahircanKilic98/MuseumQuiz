  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Der vitruvianische Mensch (1490)\n\nLeonardo vereint Kunst und Wissenschaft,
    indem er die menschlichen Proportionen in Kreis und Quadrat darstellt \u2013
    inspiriert von Vitruv. Die Zeichnung zeigt das Interesse der Renaissance an Harmonie
    und Mathematik. Sie gilt als Symbol f\xFCr das menschliche Ma\xDF in der Welt"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
  m_sharedMaterial: {fileID: 2164040, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
